# ---- Database -------------------------------------------------------------
# SQLite connection string. On local/dev machines any writable file path works.
# On serverless (Vercel) the filesystem is ephemeral — the app auto-falls back
# to /tmp and re-creates tables + seed user on cold start.
DATABASE_URL="file:./db/custom.db"

# ---- Auth -----------------------------------------------------------------
# Secret used to sign JWT session tokens (HS256). Use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Seeded demo admin account (created automatically on first boot).
AUTH_EMAIL="admin@scrapesuite.com"
AUTH_PASSWORD="Scrape2026!"

# ---- Site -----------------------------------------------------------------
# Canonical origin used for SEO metadata, sitemap, robots and Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://scrapesuite.vercel.app"
NEXT_PUBLIC_APP_URL="https://scrapesuite.vercel.app"

# Optional: enable the experimental WebGL metaball background on marketing
# pages (adds a lazy-loaded three.js bundle). Default: disabled.
# NEXT_PUBLIC_ENABLE_WEBGL="true"

# ---- Paystack (optional — billing features) --------------------------------
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_BUSINESS_PLAN_CODE=""
PAYSTACK_PRO_PLAN_CODE=""
