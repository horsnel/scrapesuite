generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  plan          String    @default("free") // free, pro, business
  apiKeys       ApiKey[]
  scrapeHistory ScrapeHistory[]
  subscription  Subscription?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique @default(cuid())
  name      String    @default("Default Key")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

model ScrapeHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  status      String   @default("success")
  result      String   // JSON string
  creditsUsed Int      @default(1)
  responseMs  Int
  createdAt   DateTime @default(now())
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paystackCode     String?  // Paystack subscription code
  paystackEmail    String?  // Paystack customer email
  plan             String   @default("free")
  status           String   @default("active") // active, cancelled, expired
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
